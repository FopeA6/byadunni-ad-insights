# The Meta Ads export to read, and your creative tags. Real exports stay out of git (see .gitignore).
ADS_CSV=data/sample-meta-export.csv
TAGS_FILE=data/tags.example.json

# Your rules
TARGET_COST_PER_PURCHASE=30
MIN_SPEND_TO_JUDGE=10
NO_CART_SPEND_LIMIT=20
CURRENCY=£

# MCP server: who may use it (Tailscale logins, comma-separated) and where it listens.
# It always listens on 127.0.0.1; share it with: tailscale serve --bg 3200
OWNER_LOGINS=owner@example.com
PORT=3200
